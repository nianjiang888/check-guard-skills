{
  "version": "2.0.0",
  "description": "guard-skill 红线规则库：覆盖提示注入后门、凭据窃取、数据外传、权限越界、代码混淆五类风险。rules.json 可增改，不写死在代码里。",
  "rules": [
    {"id": "SK-INJ-01", "name": "系统提示词泄露/越权指令", "category": "提示注入后门", "severity": "高", "pattern": "(?i)(system[\\s_-]?prompt|你必须是|忽略(以上|之前|上文)|ignore\\s+(previous|above|all))"},
    {"id": "SK-INJ-02", "name": "角色伪装注入", "category": "提示注入后门", "severity": "中", "pattern": "(?i)(假装你是|pretend\\s+(you\\s+are|to\\s+be)|你现在是|act\\s+as\\s+if)"},
    {"id": "SK-INJ-03", "name": "隐蔽指令注入(HTML/图片)", "category": "提示注入后门", "severity": "中", "pattern": "(?i)(<img[^>]+onerror|javascript:|data:text/html)"},
    {"id": "SK-CRD-01", "name": "硬编码密钥/密码", "category": "凭据窃取", "severity": "高", "pattern": "(?i)(api[_-]?key\\s*[:=]|sk-[a-z0-9]{20,}|akia[0-9a-z]{16}|password\\s*[:=]\\s*[\"'][^\"']{4,}[\"'])"},
    {"id": "SK-CRD-02", "name": "读取凭据文件", "category": "凭据窃取", "severity": "高", "pattern": "(?i)(\\.env\\b|id_rsa|id_ed25519|credentials\\.json|/\\.ssh/)"},
    {"id": "SK-CRD-03", "name": "云凭据环境变量直读", "category": "凭据窃取", "severity": "中", "pattern": "(?i)(os\\.environ\\[['\\\"](AWS|AZURE|GCP|ALIYUN|TCLOUD)_)"},
    {"id": "SK-EXF-01", "name": "外发数据到外部地址", "category": "数据外传", "severity": "高", "pattern": "(?i)(requests\\.(get|post|put|delete)\\(|urllib\\.request|http[s]?://(?!localhost|127\\.0\\.0\\.1)[0-9]{1,3}\\.[0-9]{1,3})"},
    {"id": "SK-EXF-02", "name": "Base64 编码外传", "category": "数据外传", "severity": "中", "pattern": "(?i)(base64\\.b64encode|base64\\.encode)"},
    {"id": "SK-PRV-01", "name": "远程命令执行", "category": "权限越界", "severity": "高", "pattern": "(?i)(os\\.system\\(|subprocess\\.(call|popen|run)\\([^)]*shell\\s*=\\s*true|eval\\(|exec\\()"},
    {"id": "SK-PRV-02", "name": "管道执行远程脚本", "category": "权限越界", "severity": "高", "pattern": "(?i)(curl\\b[^|]*\\|\\s*(sh|bash)|wget[^|]*\\|\\s*(sh|bash))"},
    {"id": "SK-PRV-03", "name": "危险删除/覆盖操作", "category": "权限越界", "severity": "中", "pattern": "(?i)(rm\\s+-rf|shutil\\.rmtree|os\\.remove\\()"},
    {"id": "SK-PRV-04", "name": "全局权限提升", "category": "权限越界", "severity": "中", "pattern": "(?i)(sudo\\s|chmod\\s+777|0o777)"},
    {"id": "SK-OBF-01", "name": "代码混淆/编码隐藏", "category": "代码混淆·危险", "severity": "中", "pattern": "(?i)(exec\\(base64|from\\s+base64\\s+import|\\.decode\\(['\\\"](utf-16|rot13|hex))"},
    {"id": "SK-OBF-02", "name": "反分析/环境自检", "category": "代码混淆·危险", "severity": "中", "pattern": "(?i)(detect\\s+sandbox|sys\\.argv\\[0\\].*exit|if\\s+not\\s+os\\.path\\.exists\\(.+\\):\\s*sys\\.exit)"}
  ]
}
